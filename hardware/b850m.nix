# Hardware configuration for Zeus (LIANLI machine)
# Generated by nixos-generate-config — partuuids are machine-specific.
{
  self,
  config,
  lib,
  pkgs,
  modulesPath,
  inputs,
  ...
}: {
  imports = [
    (modulesPath + "/installer/scan/not-detected.nix")
    inputs.lanzaboote.nixosModules.lanzaboote
  ];

  boot = {
    resumeDevice = "/dev/mapper/crypt-swap";

    initrd = {
      systemd.enable = true;
      availableKernelModules = [
        "nvme"
        "xhci_pci"
        "usbhid"
        "usb_storage"
        "sd_mod"
      ];
      kernelModules = ["tpm_tis"];
      luks.devices = {
        "crypt-root" = {
          device = "/dev/disk/by-partuuid/fb6d0299-66aa-4cd1-a02e-ba0356a64190";
          crypttabExtraOpts = ["tpm2-device=auto"];
        };
        "crypt-swap" = {
          device = "/dev/disk/by-partuuid/cba2a49d-f92a-4abd-8ea6-66baf7b6cb7d";
          crypttabExtraOpts = ["tpm2-device=auto"];
        };
      };
    };
    kernelModules = [
      "r8125"
      "kvm-amd"
      "amdgpu"
      "overlay"
      "br_netfilter"
      "it87" # motherboard fan/temp sensors (ITE - Gigabyte B850M)
      "drivetemp" # HDD/SSD temperature readings
    ];
    blacklistedKernelModules = ["r8169"];
    extraModulePackages = [
      config.boot.kernelPackages.r8125
      config.boot.kernelPackages.it87 # out-of-tree it87 (frankcrawford/it87) for the B850M's IT8689E
    ];
    loader = {
      systemd-boot.enable = lib.mkForce false;
      systemd-boot.configurationLimit = 8;
      efi.canTouchEfiVariables = true;
    };
    lanzaboote = {
      enable = true;
      pkiBundle = "/var/lib/sbctl";
      configurationLimit = 8; # measured boot requires <=8 (policy allows at most 8 boot variants)
      measuredBoot = {
        enable = true;
        # PCR 7 prediction is affected by systemd #40381 (AMD fTPM authority events arriving out of order),
        # predicted != actual values break unlocking; add it back once upstream fixes it
        pcrs = [0 4];
      };
    };
    kernelPackages = pkgs.linuxPackages_zen;
    kernelParams = [
      "pcie_aspm=off"
      "pcie_port_pm=off"
      "pci=noaer"
      "amdgpu.ppfeaturemask=0xfff7ffff" # RX 7900 XT (RDNA3) fan control
    ];
    extraModprobeConfig = ''
      options mt7921e disable_aspm=1
      options it87 ignore_resource_conflict=1 # B850M IT8696E ACPI conflict
    '';
  };

  fileSystems = {
    "/" = {
      device = "/dev/disk/by-label/NIXOS";
      fsType = "btrfs";
      options = [
        "subvol=@"
        "compress=zstd"
      ];
    };
    "/home" = {
      device = "/dev/disk/by-label/NIXOS";
      fsType = "btrfs";
      options = [
        "subvol=@home"
        "compress=zstd"
      ];
    };
    "/nix" = {
      device = "/dev/disk/by-label/NIXOS";
      fsType = "btrfs";
      options = [
        "subvol=@nix"
        "compress=zstd"
      ];
    };
    "/var/log" = {
      device = "/dev/disk/by-label/NIXOS";
      fsType = "btrfs";
      options = [
        "subvol=@log"
        "compress=zstd"
      ];
    };
    "/boot" = {
      device = "/dev/disk/by-partuuid/d225d8fc-651b-48d8-aba0-a8c7730e4abe";
      fsType = "vfat";
      options = [
        "fmask=0022"
        "dmask=0022"
      ];
    };
  };

  swapDevices = [
    {
      device = "/dev/mapper/crypt-swap";
      priority = -1;
    }
  ];

  networking.networkmanager.wifi.powersave = lib.mkForce false;

  nixpkgs.hostPlatform = lib.mkDefault "x86_64-linux";

  services.udev.extraRules = ''
    # Disable runtime power management for the mt7921e WiFi device,
    # so it doesn't disappear from the PCIe bus under heavy load (e.g. Steam downloads)
    SUBSYSTEM=="pci", DRIVER=="mt7921e", ATTR{power/control}="on"
  '';

  hardware = {
    cpu.amd.updateMicrocode = lib.mkDefault config.hardware.enableRedistributableFirmware;
    bluetooth = {
      enable = true;
      powerOnBoot = true;
    };
    graphics = {
      enable = true;
      enable32Bit = true;
      extraPackages = with pkgs; [
        rocmPackages.clr.icd
        rocmPackages.rocm-runtime
      ];
    };
  };

  environment.variables = {
    ROC_ENABLE_PRE_VEGA = "1";
    ROCR_VISIBLE_DEVICES = "1";
    HIP_VISIBLE_DEVICES = "1";
  };
}
